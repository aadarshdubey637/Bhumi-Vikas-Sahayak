# Copy to .env (never commit .env). Names/placeholders only - no real secrets here.
# Comments are on their own lines on purpose: some env-file parsers (docker --env-file) do not strip inline comments.

# development | test | production. Production refuses SQLite, AUTH_MODE=none
# AUTH_MODE=accounts: public tools for guests, saving needs a signed-in account (sessions in an HttpOnly cookie).
# COOKIE_SAMESITE=lax        # "none" (needs https) when the web app and the API are on different sites
# FRONTEND_URL=http://localhost:5173
# REGISTRATION_OPEN=true
# SMTP_HOST=  SMTP_PORT=587  SMTP_USER=  SMTP_PASSWORD=  SMTP_FROM="NirmaanSetu <no-reply@example.org>"   # password-reset e-mail; unset in development = link is logged, wildcard CORS.
APP_ENV=development

# Local: SQLite. Production/Render: the PostgreSQL URL. Render's "postgres://..." / "postgresql://..." form is accepted
# as-is and rewritten to the psycopg 3 driver (postgresql+psycopg://).
DATABASE_URL=sqlite:///./nirmaansetu.db

# docker-compose only (the db container's password).
POSTGRES_PASSWORD=change-me

# true: run 'alembic upgrade head' inside the API process at start-up (single replica only).
AUTO_MIGRATE=false

# Docker/Render entrypoint only: 1 = load data/raw/*.jsonl into the database at boot (idempotent).
INGEST_ON_START=0

# --- Frontend access (CORS) -------------------------------------------------------------------
# Exact frontend origin(s), comma separated, scheme + host (+ port), NO path. A trailing slash is stripped. "*" is rejected in production.
CORS_ORIGINS=http://localhost:5173
# Optional anchored regex for origins you cannot list (e.g. preview deployments): ^https://pr-[0-9]+\.example\.com$
CORS_ORIGIN_REGEX=

# --- Server (Docker/Render) -------------------------------------------------------------------
# Render injects PORT itself; leave unset there.
PORT=8000
# Keep 1: the rate limiter and the search index are per process.
WEB_CONCURRENCY=1
# Behind Render's proxy set to * so client IPs (rate limiting) come from X-Forwarded-For. Only do this when the app is NOT
# directly reachable from the internet.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Data files ---------------------------------------------------------------------------------
CORPUS_PATH=data/processed/corpus_rules.jsonl
AMENDMENTS_PATH=data/pending/amendments_pending.json
REVIEWS_PATH=data/verified/rule_reviews.jsonl

# --- Limits -------------------------------------------------------------------------------------
MAX_QUESTION_CHARS=1000
MAX_REQUEST_BYTES=65536
REQUEST_TIMEOUT_SECONDS=30
# Per API key (or per client IP without one). Several clerks may share one key and each page load makes a few calls: 240 is a sensible start for a shared office key.
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO

# --- Authentication -----------------------------------------------------------------------------
# none (development only) | api_key (required in production)
AUTH_MODE=none
# owner:sha256hex[,owner2:sha256hex]. Generate a key and its hash:
#   python -c "import secrets,hashlib;k=secrets.token_urlsafe(32);print(k, hashlib.sha256(k.encode()).hexdigest())"
API_KEY_HASHES=

# --- Optional LLM explanation (exact lookup / search / calculations never need it) ---------------
# none | anthropic | google
LLM_PROVIDER=none
# Leave blank for the provider default (anthropic: claude-sonnet-5-5, google: gemini-2.5-flash).
LLM_MODEL=
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1
LLM_MAX_OUTPUT_TOKENS=1500
# Required (non-blank) only when LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required (non-blank) only when LLM_PROVIDER=google (Gemini key from Google AI Studio). Put the real key in your
# untracked .env or the Render dashboard, never in this file.
GOOGLE_API_KEY=

# --- WhatsApp "Rule Dost" + phone "Nirmaan Helpline" (all optional; blank = channel off, NOT yet tested with real providers) ---
# Required as soon as any WhatsApp or Twilio value is set: key for the one-way hash that replaces phone numbers / call ids in the database.
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
PII_HASH_SECRET=
# The exact public origin Meta/Twilio call (used to check the Twilio signature), e.g. https://your-service.onrender.com
PUBLIC_BASE_URL=
# WhatsApp Cloud API (Meta). Webhook URL: <PUBLIC_BASE_URL>/api/v1/channels/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
# Optional approved template for sending a written answer after a call (outside the 24h window)
WHATSAPP_FOLLOWUP_TEMPLATE=
WHATSAPP_FOLLOWUP_TEMPLATE_LANGUAGE=hi
# Twilio Voice. Voice webhook: <PUBLIC_BASE_URL>/api/v1/channels/voice/incoming
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Only for texting the written answer after a call (India needs DLT registration)
TWILIO_SMS_FROM=
VOICE_LANGUAGE=hi-IN
VOICE_TTS_VOICE=Polly.Aditi
# Voice-note transcription: none | openai (then OPENAI_API_KEY is required)
STT_PROVIDER=none
STT_MODEL=whisper-1
OPENAI_API_KEY=
# Simulated demo endpoints. Default: on in development, off in production.
CHANNELS_DEMO_ENABLED=
CHANNELS_USE_LLM_EXPLANATION=false

# --- Retrieval ------------------------------------------------------------------------------------
# true needs sentence-transformers (not in requirements.txt); not evaluated - see README.
SEMANTIC_ENABLED=false
