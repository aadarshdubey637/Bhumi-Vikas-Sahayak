{
  "name": "nirmaansetu-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build && node scripts/check-bundle.mjs && node scripts/contrast-check.mjs",
    "test:contract": "node scripts/contract.mjs",
    "test:live": "node scripts/live-smoke.mjs",
    "check:contrast": "node scripts/contrast-check.mjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.1.0",
    "@fontsource/noto-sans-devanagari": "5.1.0",
    "@hookform/resolvers": "3.9.1",
    "@radix-ui/react-dialog": "1.1.2",
    "@radix-ui/react-tabs": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.4",
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.14",
    "@tanstack/react-query": "5.62.0",
    "i18next": "24.0.5",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.0",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.30.6",
    "three": "0.169.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "9.16.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.10.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "9.16.0",
    "eslint-plugin-react-hooks": "5.1.0",
    "eslint-plugin-react-refresh": "0.4.16",
    "globals": "15.13.0",
    "jsdom": "25.0.1",
    "msw": "2.6.8",
    "postcss": "8.4.49",
    "prettier": "3.4.2",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.18.0",
    "vite": "6.0.3",
    "vitest": "2.1.8",
    "vitest-axe": "0.1.0"
  },
  "overrides": {
    "vite": "6.0.3"
  }
}
