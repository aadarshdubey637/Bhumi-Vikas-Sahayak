# The ONLY setting the frontend needs. Copy to .env.local for local work (git-ignored).
# Base URL (origin) of the backend: no trailing slash and NO /api/v1 (the client appends it).
# It is inlined into the public JavaScript bundle at build time - never put a key or secret in it.
#
# Local:       http://localhost:8000
# Production:  set in Vercel (Project > Settings > Environment Variables) to your Render service origin,
#              e.g. https://nirmaansetu-api.onrender.com  - https is required in production builds.
VITE_API_BASE_URL=http://localhost:8000
